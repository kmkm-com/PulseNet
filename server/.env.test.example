# ==============================================================================
# PulseNet Local Disposable Test Environment Configuration
# Copy this file to server/.env.test for running automated tests locally.
# NEVER commit server/.env.test to version control.
# ==============================================================================

NODE_ENV=test

# Strictly use local disposable PostgreSQL database (localhost / 127.0.0.1)
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pulsenet_test_schema
DB_SSL=false

# Test JWT Secret
JWT_SECRET=super_secret_test_jwt_key_at_least_32_characters_long
