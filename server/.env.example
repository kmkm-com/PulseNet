# ==============================================================================
# PulseNet Server Environment Configuration Example
# Copy this file to server/.env and fill in your actual credentials.
# NEVER commit the actual server/.env file to version control.
# ==============================================================================

# Server Port
PORT=5000

# Database Configuration (Supabase PostgreSQL or Local PostgreSQL)
# You can provide DATABASE_URL (recommended for Supabase pooler):
DATABASE_URL=postgres://[user].[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres
DB_SSL=true

# Alternatively, configure individual PostgreSQL keys:
# DB_USER=postgres
# DB_HOST=localhost
# DB_NAME=pulsenet_db
# DB_PASSWORD=your_password_here
# DB_PORT=5432
# DB_SSL=false

# Supabase API & Storage Configuration
SUPABASE_URL=https://[your-project-ref].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Authentication Secret
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_64_byte_hex_secret

# Platform Operators (comma-separated user IDs with administrative privileges)
PLATFORM_OPERATOR_IDS=1
